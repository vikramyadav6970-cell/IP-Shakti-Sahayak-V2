# ==============================================================================
# IP-SAKTI Sahayak — Backend Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME="IP-SAKTI Sahayak API"
DEBUG=true
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database — Supabase Postgres (Session pooler mode)
# In Supabase Dashboard: Project Settings > Database > Connection string (URI, Session pooler, port 5432)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# For synchronous tools like Alembic migrations:
DATABASE_URL_SYNC=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Cache & Celery Broker — Upstash Redis
# In Upstash Dashboard: Create Database > REST / Details > copy rediss:// URL
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# Object Storage — Supabase Storage (S3-compatible API)
# In Supabase Dashboard: Project Settings > Storage > S3 Access Keys
S3_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY=[YOUR-S3-ACCESS-KEY]
S3_SECRET_KEY=[YOUR-S3-SECRET-KEY]
S3_BUCKET=documents
S3_REGION=ap-south-1

# Authentication & Security
# Generate a strong 32+ char secret: openssl rand -hex 32
JWT_SECRET=supersecret-development-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector Database & Embeddings (for live semantic retrieval)
QDRANT_URL=https://[YOUR-CLUSTER-ID].eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=[YOUR-QDRANT-API-KEY]
EMBEDDING_PROVIDER=bge-m3
HF_TOKEN=your_huggingface_hub_token_here

# LLM Providers (At least one key required for live AI reasoning)
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
# OpenAI Platform: https://platform.openai.com
OPENAI_API_KEY=
# Anthropic Console: https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Translation API (Sarvam AI)
# Sarvam AI Platform: https://api.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Optional External Monitoring
SENTRY_DSN=
