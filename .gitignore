# ==============================================================================
# IP-SAKTI Sahayak — Git Ignore Configuration
# ==============================================================================

# User Datasets & Heavy Corpora
ai/DataSet/
ai/DataSet/**
**/DataSet/
**/DataSet/**
DataSet/

# Environment Variables & API Secrets (Always keep .env.example tracked)
.env
.env.*
*.env
!*.env.example
!.env.example

# Python Caches, Virtual Envs & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/

# Node.js & Frontend Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.next/
**/.next/
*.tsbuildinfo
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases, SQLite & Temporary Files
*.db
*.sqlite
*.sqlite3
test_local.db
*.log

# IDE & Operating System Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
.agents/
.system_generated/
