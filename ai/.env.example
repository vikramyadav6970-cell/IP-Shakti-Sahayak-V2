# ==============================================================================
# IP-SAKTI Sahayak — AI Layer Environment Configuration
# ==============================================================================

# Vector Database — Qdrant Cloud
QDRANT_URL=https://[YOUR-CLUSTER-ID].eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Embeddings (Default: bge-m3 for live GPU/CPU retrieval; set to 'mock' only for isolated test runs)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_DIMENSION=1024
HF_TOKEN=your_huggingface_hub_token_here
